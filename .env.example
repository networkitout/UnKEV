# Required
ANTHROPIC_API_KEY=
UNKEV_PASSWORD=

# Optional. NVD_API_KEY raises NVD rate limits about 10x.
#NVD_API_KEY=
#UNKEV_USER=operator
#UNKEV_DB=/data/unkev.db
#UNKEV_CONFIG_DIR=config
# Any model from GET /v1/models. Cheaper extraction: claude-haiku-5-5 or claude-sonnet-5.
#UNKEV_EXTRACT_MODEL=claude-opus-5-5
#UNKEV_BRIEF_MODEL=claude-opus-5-5
#UNKEV_LLM_DAILY_TOKENS=400000
#UNKEV_LLM_BATCH=8
#UNKEV_HTTP_TIMEOUT=30
#UNKEV_UA=UnKEV/0.2 (+https://github.com/networkitout/UnKEV)
#UNKEV_INPROCESS_WORKER=0
#UNKEV_INTERVAL_MIN=60
